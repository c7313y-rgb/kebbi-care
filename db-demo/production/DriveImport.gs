/* CSV intake from a later-configured Google Drive folder. */
function careDriveEnsure_(){careEnsure_();SCHEMA_.care_drive_files=['file_id','modified_at','file_hash','status','imported_at','error'];if(!db_().getSheetByName('care_drive_files')){var s=db_().insertSheet('care_drive_files');s.getRange(1,1,1,SCHEMA_.care_drive_files.length).setValues([SCHEMA_.care_drive_files]);s.setFrozenRows(1);}}
function careDriveConfig_(){return Object.assign({folder_id:'',folder_name:'',site_id:'yururia',encoding:'auto',auto:false,on_open:true},getSetting_('care_drive_config',{}));}
function careDriveFolder_(c){if(!c.folder_id)throw new Error('Google DriveのフォルダURLを登録してください');return DriveApp.getFolderById(c.folder_id);}
function adminCareDriveStatus(key){needAdmin_(key);careDriveEnsure_();var c=careDriveConfig_();return {config:c,configured:!!c.folder_id,last:getSetting_('care_drive_last',null),account:MAIL_ACCOUNT_};}
function adminCareDriveConfigure(key,input){needAdmin_(key);mailAccount_();return withLock_(function(){careDriveEnsure_();input=input||{};var raw=String(input.folder_url||'').trim(),match=raw.match(/^https:\/\/drive\.google\.com\/(?:drive\/)?(?:u\/\d+\/)?folders\/([A-Za-z0-9_-]+)(?:[/?#].*)?$/),id=match?match[1]:/^[A-Za-z0-9_-]{10,}$/.test(raw)?raw:'';if(!id)throw new Error('Google DriveのフォルダURLを入力してください');var folder=DriveApp.getFolderById(id);if(!careMasters_().sites.some(function(s){return s.site_id===input.site_id;}))throw new Error('取込先の施設を選択してください');if(['auto','UTF-8','Shift_JIS'].indexOf(input.encoding)<0)throw new Error('文字コードを選択してください');var c={folder_id:id,folder_name:folder.getName(),site_id:input.site_id,encoding:input.encoding,auto:input.auto===true,on_open:input.on_open!==false};setSetting_('care_drive_config',c);PropertiesService.getScriptProperties().setProperty('CARE_DRIVE_CURSOR','');ScriptApp.getProjectTriggers().filter(function(t){return t.getHandlerFunction()==='careDriveImportTrigger_';}).forEach(function(t){ScriptApp.deleteTrigger(t);});if(c.auto)ScriptApp.newTrigger('careDriveImportTrigger_').timeBased().everyMinutes(5).create();return adminCareDriveStatus(key);});}
function careDriveLogMap_(){var map={};readTable_('care_drive_files').rows.forEach(function(r){map[r.file_id]=r;});return map;}
function careDriveLog_(entry){var t=readTable_('care_drive_files'),i=t.rows.findIndex(function(r){return r.file_id===entry.file_id;});if(i>=0)writeRow_('care_drive_files',t.rowNo[i],entry);else appendRows_('care_drive_files',[entry]);}
function adminCareDriveList(key,input){needAdmin_(key);careDriveEnsure_();input=input||{};var c=careDriveConfig_(),folder=careDriveFolder_(c),it=input.cursor?DriveApp.continueFileIterator(input.cursor):folder.getFiles(),log=careDriveLogMap_(),files=[],scanned=0,search=String(input.search||'').toLowerCase();while(it.hasNext()&&files.length<50&&scanned<500){var f=it.next();scanned++;if(!/\.csv$/i.test(f.getName())||search&&f.getName().toLowerCase().indexOf(search)<0)continue;var parents=f.getParents(),allowed=false;while(parents.hasNext())if(parents.next().getId()===c.folder_id)allowed=true;if(!allowed)continue;var at=f.getLastUpdated().toISOString(),old=log[f.getId()];files.push({id:f.getId(),name:f.getName(),size:f.getSize(),modified_at:at,status:old&&old.modified_at===at?old.status:old?'changed':'new',error:old&&old.modified_at===at?old.error:''});}return {files:files,cursor:it.hasNext()?it.getContinuationToken():'',folder_name:folder.getName()};}
function careDriveRead_(ids,c){if(!Array.isArray(ids)||!ids.length||ids.length>20)throw new Error('CSVを1〜20ファイル選択してください');return ids.map(function(id){var f=DriveApp.getFileById(String(id)),parents=f.getParents(),allowed=false;while(parents.hasNext())if(parents.next().getId()===c.folder_id)allowed=true;if(!allowed)throw new Error('登録したフォルダ内のCSVを選択してください');if(!/\.csv$/i.test(f.getName())||f.getSize()>5*1024*1024)throw new Error('CSV形式・5MB以内のファイルを選択してください：'+f.getName());var blob=f.getBlob(),text=blob.getDataAsString(c.encoding==='Shift_JIS'?'Shift_JIS':'UTF-8');if(c.encoding==='auto'&&text.indexOf('\uFFFD')>=0)text=blob.getDataAsString('Shift_JIS');return {id:f.getId(),name:f.getName(),text:text,modified_at:f.getLastUpdated().toISOString(),hash:sha256_(text)};});}
function careDriveToken_(files,revision,c){return sha256_(JSON.stringify({revision:revision,folder:c.folder_id,site:c.site_id,encoding:c.encoding,files:files.map(function(f){return [f.id,f.modified_at,f.hash];})}));}
function adminCareDrivePreview(key,input){needAdmin_(key);careDriveEnsure_();var c=careDriveConfig_(),files=careDriveRead_(input.ids,c),prepared=carePrepare_({revision:input.revision,site_id:c.site_id,files:files});return {token:careDriveToken_(files,prepared.snapshot.revision,c),added:prepared.plan.added,updated:prepared.plan.updated,duplicates:prepared.plan.duplicates,warnings:prepared.plan.warnings,total:prepared.plan.input,files:files.map(function(f){return {id:f.id,name:f.name};}),sample:prepared.plan.records.filter(function(r){return (r.sources||[]).some(function(s){return files.some(function(f){return f.name===s.file;});});}).slice(0,5)};}
function adminCareDriveImport(key,input){needAdmin_(key);return withLock_(function(){careDriveEnsure_();var c=careDriveConfig_(),files=careDriveRead_(input.ids,c),prepared=carePrepare_({revision:input.revision,site_id:c.site_id,files:files});if(!input.token||input.token!==careDriveToken_(files,prepared.snapshot.revision,c))throw new Error('ファイルまたは設定が変更されました。もう一度照合してください');careDriveSave_(files,prepared);return careResponse_(key);});}
function careDriveSave_(files,prepared){careArchiveFiles_(files);if(prepared.plan.added||prepared.plan.updated)careBackup_('before-drive');var result=careApply_(prepared,files.map(function(f){return 'Drive: '+f.name;}));files.forEach(function(f){careDriveLog_({file_id:f.id,modified_at:f.modified_at,file_hash:f.hash,status:'done',imported_at:nowIso_(),error:''});});setSetting_('care_drive_last',{at:nowIso_(),added:result.added,updated:result.updated,files:files.length});return result;}
function careDriveSync_(){return withLock_(function(){careDriveEnsure_();var c=careDriveConfig_();if(!c.folder_id)return {not_configured:true};var props=PropertiesService.getScriptProperties(),cursor=props.getProperty('CARE_DRIVE_CURSOR'),it;try{it=cursor?DriveApp.continueFileIterator(cursor):careDriveFolder_(c).getFiles();}catch(e){it=careDriveFolder_(c).getFiles();}var log=careDriveLogMap_(),ids=[],scanned=0;while(it.hasNext()&&ids.length<10&&scanned<200){var f=it.next();scanned++;if(!/\.csv$/i.test(f.getName()))continue;var old=log[f.getId()];if(old&&old.modified_at===f.getLastUpdated().toISOString()&&old.status==='done')continue;ids.push(f.getId());}props.setProperty('CARE_DRIVE_CURSOR',it.hasNext()?it.getContinuationToken():'');var result={added:0,updated:0,errors:0,files:0};ids.forEach(function(id){try{var files=careDriveRead_([id],c),prepared=carePrepare_({site_id:c.site_id,files:files}),r=careDriveSave_(files,prepared);result.added+=r.added;result.updated+=r.updated;result.files++;}catch(e){var f=DriveApp.getFileById(id);careDriveLog_({file_id:id,modified_at:f.getLastUpdated().toISOString(),file_hash:'',status:'error',imported_at:nowIso_(),error:String(e.message||e).slice(0,500)});result.errors++;}});setSetting_('care_drive_last',Object.assign({at:nowIso_()},result));return result;});}
function careDriveImportTrigger_(){if(careDriveConfig_().auto)return careDriveSync_();}
function adminCareDriveOnOpen(key){needAdmin_(key);return careDriveConfig_().on_open?careDriveSync_():{not_configured:true};}
function adminCareDriveSync(key){needAdmin_(key);return careDriveSync_();}
